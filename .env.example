# Copiar a .env.local y ajustar.

# mock = datos de ejemplo en memoria (no necesita backend)
# hybrid = login/sesión contra el backend .NET real (API_BASE_URL) y el resto con datos mock;
#          el alumno entra con usuario y contraseña. Ej.: API_BASE_URL=http://localhost:5087/api/v1
# http = conecta con la API .NET en API_BASE_URL
API_MODE=mock

# URL base de la API .NET (solo se usa en el servidor de Next; nunca llega al navegador)
API_BASE_URL=http://localhost:5000/api

# Tiempo máximo por petición al backend (ms). Si se supera, se aborta y se muestra un error controlado.
API_TIMEOUT_MS=8000

# Duración de la sesión en el navegador con el backend real (días). Debe ser ≤ Authentication__RefreshTokenDays
# del backend (7 por defecto). El token de acceso dura 15 min y se renueva solo antes de vencer.
SESSION_MAX_AGE_DAYS=7

# Poner en false si Nginx/Caddy ya comprime las respuestas
NEXT_COMPRESS=true

# ── Solo modo mock ──
# Secreto para firmar las sesiones de prueba (si falta, se genera uno al arrancar y las sesiones
# se invalidan al reiniciar). NUNCA usar el modo mock en producción real.
MOCK_SESSION_SECRET=
# Latencia simulada de la "API" en ms (para ver los estados de carga)
MOCK_LATENCY_MS=120
